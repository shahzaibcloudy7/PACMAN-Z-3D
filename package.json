{
  "name": "pacman3d-z",
  "version": "1.1.1",
  "description": "PACMAN3D-Z - Modern Pacman game with real 3D view, power-ups and shooting mechanics",
  "main": "main.js",
  "author": "shahzaibcloudy7",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder build --win --publish never",
    "build:dir": "electron-builder build --win --dir",
    "dist": "electron-builder"
  },
  "keywords": [
    "game",
    "pacman",
    "electron",
    "desktop"
  ],
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "rcedit": "^3.1.0",
    "three": "^0.159.0"
  },
  "build": {
    "appId": "com.pacmanz.game",
    "productName": "PACMAN3D-Z",
    "directories": {
      "output": "dist"
    },
    "files": [
      "browser/**/*",
      "!browser/**/*.png",
      "!browser/server.js",
      "!browser/README.md",
      "main.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PACMAN3D-Z"
    },
    "portable": {
      "artifactName": "PACMAN3D-Z-Portable.exe"
    },
    "compression": "maximum",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "copyright": "Copyright (c) 2026 shahzaibcloudy7",
    "afterPack": "build/afterPack.js"
  }
}
