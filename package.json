{
  "name": "pacman-z",
  "version": "1.0.0",
  "description": "PACMAN3D-Z - Modern Pacman game with power-ups and shooting mechanics",
  "main": "main.js",
  "author": "Your Name",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder build --win --publish never",
    "build:dir": "electron-builder build --win --dir",
    "dist": "electron-builder"
  },
  "keywords": [
    "game",
    "pacman",
    "electron",
    "desktop"
  ],
  "dependencies": {},
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.pacmanz.game",
    "productName": "PACMAN3D-Z",
    "directories": {
      "output": "dist"
    },
    "files": [
      "browser/index.html",
      "browser/pacman.js",
      "browser/sounds.js",
      "browser/effects.js",
      "browser/style.css",
      "main.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PACMAN3D-Z"
    },
    "portable": {
      "artifactName": "PACMAN3D-Z-Portable.exe"
    },
    "compression": "maximum",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  }
}
